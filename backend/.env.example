# DevLeap AI Backend - Environment Variables
# Copy this file to .env and fill in real values. Never commit .env.

# PostgreSQL connection string (asyncpg reads it directly; Prisma uses it for migrations)
DATABASE_URL=

# Stripe (billing)
STRIPE_SECRET_KEY=
# Must be a webhook secret (starts with whsec_), not your API secret key.
# Locally: `stripe listen --forward-to localhost:8000/api/v1/billing/webhook`
STRIPE_WEBHOOK_SECRET=

# Clerk (auth)
CLERK_SECRET_KEY=
CLERK_FRONTEND_API=

# Deployed frontend origin, used for CORS
FRONTEND_URL=http://localhost:3000

# ── LLM (any OpenAI-compatible endpoint) ──────────────────────────────
# Defaults target a local LM Studio server (Developer tab → Start Server).
LLM_BASE_URL=http://localhost:1234/v1
LLM_MODEL=google/gemma-4-e2b
LLM_API_KEY=lm-studio
LLM_MAX_INPUT_CHARS=120000
LLM_TIMEOUT_SECONDS=600

# ── Web search (powers "Find jobs for me") ────────────────────────────
# none | searxng | tavily | brave
SEARCH_PROVIDER=none
# SEARXNG_URL=http://localhost:8888
# TAVILY_API_KEY=
# BRAVE_API_KEY=

# ── Rate limiting (optional overrides, sane defaults if unset) ───────
# INGEST_RATE_LIMIT=5
# INGEST_RATE_LIMIT_WINDOW_SECONDS=3600
# BROKER_RATE_LIMIT=20
# BROKER_RATE_LIMIT_WINDOW_SECONDS=3600
# CONTACT_RATE_LIMIT=5
# CONTACT_RATE_LIMIT_WINDOW_SECONDS=3600
